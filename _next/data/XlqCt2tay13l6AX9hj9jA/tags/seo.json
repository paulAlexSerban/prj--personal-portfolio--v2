m":{"id":"my-projects-section","type":"section"},"content":[{"title":{"main":"Projects"}},{"children":[{"organism":{"id":"posts-overview","type":"postsOverview"},"content":{"section":"portfolio","category":{"category_name":"project","category_url":"project"},"list":[{"title":"ITaaS Agency - Landing Page","subheading":"Landing page for a business that offers IT-as-a-Service services.","excerpt":"A proof-of-concept landing page for a fictitious IT-as-a-Service (ITaaS) company to showcase its services and facilitate customer engagement. The website highlights the benefits of using the company's services and provides a way for potential customers to contact the business.","priority":1,"section":"portfolio","category":"Front-end Development","type":"Landing Page","experience_type":"personal project","repo_url":"https://github.com/paulAlexSerban/prj--agency-landing-page","demo_url":"https://paulalexserban.github.io/prj--agency-landing-page/","status":"draft","pinned":false,"date":"October 10, 2022","tags":["Responsive Web Design","Web Accessibility (a11y)","Next.js","SEO","JavaScript","Scss/Sass","Gulp","Webpack","JAMstack","GitHub Actions","AWS","SSG","CI/CD","Serverless","Lambda"],"slug":"prj--agency-landing-page"}]},"showViewAllButton":true,"showPagination":false}]}]},"section__posts":{"organism":{"id":"my-posts-section","type":"section"},"content":[{"title":{"main":"Posts"}},{"children":[{"organism":{"id":"posts-overview","type":"postsOverview"},"content":{"section":"blog","category":{"category_name":"post","category_url":"post"},"list":[{"title":"ARIA: The Key to Making Your Web Applications More Accessible","author":"Paul Serban","category":"Front-end Development","date":"January 17, 2019","excerpt":"ARIA, which stands for Accessible Rich Internet Applications, is a set of attributes and roles that can be added to HTML elements to provide additional information about their purpose and behavior. ARIA is an essential tool for improving the accessibility of web applications and ensuring that everyone, regardless of ability, can access and use the content.","pinned":false,"status":"published","subheading":"Understanding ARIA Roles, Properties, and Best Practices for Web Accessibility","tags":["Web Development","HTML","Web Accessibility (a11y)","SEO"],"slug":"aria-the-ket-to-making-your-web-apps-accessible"},{"title":"HTML Forms: The Importance of Proper HTML Form Semantics for User Experience and Accessibility","subheading":"How semantic form markup shapes inclusive, maintainable, and delightful web interactions","excerpt":"Discover why proper HTML form semantics matter for accessibility, user experience, and maintainability. Learn practical patterns and anti-patterns from real engineering scenarios.","author":"Paul Serban","category":"Front-end Development","date":"January 14, 2019","status":"published","tags":["Web Development","HTML","Web Accessibility (a11y)","SEO","Forms"],"slug":"html-forms-the-importance-of-html-forms"},{"author":"Paul Serban","date":"January 13, 2019","excerpt":"HTML semantics play a crucial role in web development as they provide context to web content. It helps web browsers, search engines, and assistive technologies understand the structure and purpose of the content. There are several best practices for using HTML semantics, including using descriptive HTML tags, using ARIA roles, using micro-data, using nested HTML tags correctly, using form semantics, and validating HTML. ","pinned":false,"status":"published","subheading":"Enhance your web development skills with HTML semantics to improve accessibility, SEO, and user experience.","tags":["Web Development","HTML","Accessibility","SEO","Search Engine Optimization"],"title":"HTML Semantics: Best practices and tips for better web development","slug":"html-semantics-best-practices-and-tips"},{"title":"Web Accessibility: Why It Matters and How to Implement It","subheading":"How to Make Your Website Accessible to All Users","excerpt":"Web accessibility ensures websites and digital content are usable by people with disabilities, improving user experience, expanding audience reach, and fulfilling legal obligations. Learn key principles and implementation strategies.","status":"published","pinned":false,"author":"Paul Serban","date":"January 16, 2019","tags":["Web Development","Front-end Development","Web Accessibility (a11y)","Web Standards","HTML","SEO","Web Design","User Experience","Inclusive Design","WCAG","Semantic HTML"],"slug":"web-accessibility-why-it-matters-and-how-to-implement-it"},{"author":"Paul Serban","date":"March 23, 2019","status":"published","title":"SSG, SSR, and CSR in Web Development","subheading":"Benefits and Drawbacks","excerpt":"A brutally honest deep dive into Static Site Generation (SSG), Server-Side Rendering (SSR), and Client-Side Rendering (CSR)-their real performance trade-offs, SEO implications, infrastructure costs, and when each architecture actually makes sense","tags":["Web Development","SSG","SSR","CSR","Web Performance","SEO","Software Architecture","Developer Experience"],"slug":"ssg-ssr-and-csr-in-web-developemnt-benefits-and-drawbacks"},{"title":"Essential SEO Strategies for Web Developers","subheading":"Keyword Research, On-page Optimization, Technical SEO, and Link Building","excerpt":"Search Engine Optimization (SEO) is a crucial aspect of website development, and web developers play a significant role in ensuring their website is optimized for search engines. By focusing on keyword research, on-page optimization, technical SEO, and link building, you can improve your website's search engine ranking and drive more organic traffic. Keyword research is the foundation of a successful SEO strategy, and on-page optimization involves optimizing individual pages on your website, such as the title tags, meta descriptions, headings, URL structure, and content.","status":"published","pinned":false,"author":"Paul Serban","date":"May 03, 2019","tags":["Web Development","SEO","Search Engine Optimization"],"slug":"essential-seo-strategies-for-web-developers"},{"author":"Paul Serban","date":"May 04, 2019","excerpt":"Sitemaps are an essential tool for webmasters looking to improve their website's visibility and usability. They serve as a roadmap for search engines and users, helping them navigate and discover the content on your site more efficiently. In this blog post, we will explore the basic concepts of sitemaps, their benefits, and how to create and submit one for your website.","pinned":false,"priority":1,"status":"published","subheading":"Helping search engines and users navigate your website more efficiently.","tags":["SEO","Webmaster","Content Management System","HTML","Search Engine Optimization","Wordpress","CMS"],"title":"Understanding the Basics of Sitemaps: A Guide for Webmasters","slug":"understanding-the-basics-of-sitemaps-a-guide-for-webmasters"},{"title":"Developing a Promotional Website: Best Practices and Strategies","excerpt":"A Software Engineer's Guide to Building High-Performance Marketing Sites","subheading":"Learn architectural patterns, performance optimization, and deployment strategies for building scalable promotional websites that convert visitors effectively.","author":"Paul Serban","date":"September 26, 2019","pinned":false,"status":"published","tags":["Web Development","Performance Optimization","SEO","Content Management","CI/CD","Analytics","Marketing Technology","Promotional Websites","Software Engineering","Software Architecture","System Design","Static Site Generation","SSG"],"slug":"developing-a-promotional-website-best-practices-and-strategies"},{"title":"Building a Static Site Landing Page with Eleventy (11ty)","subheading":"A Practical Engineering Guide","date":"March 23, 2020","excerpt":"Learn how to build a fast, maintainable static site landing page with Eleventy (11ty). Covers setup, templating, data pipelines, and deployment best practices.","status":"published","author":"Paul Serban","tags":["Project Management","Static Site Generation","SSG","JAMstack","Eleventy","11ty","Web Development","Performance Optimization","SEO","Accessibility","Netlify"],"slug":"ssg-landing-page-with-11ty-project-brief-document"}]},"showViewAllButton":true,"showPagination":false}]}]},"section__coursework":{"organism":{"id":"my-coursework-section","type":"section"},"content":[{"title":{"main":"Coursework"}},{"children":[{"organism":{"id":"posts-overview","type":"postsOverview"},"content":{"section":"portfolio","category":{"category_name":"coursework","category_url":"coursework"},"list":[{"title":"Natours - Tours in the Nature","subheading":"Landing Page prototype for a Green Outdoor Tours Business","excerpt":"Fictional business that offers green outdoor tours in the Carpathian mountains. This project is a landing page for the business built using modern technologies and best practices in web development. The page is fully responsive, accessible, and optimized for search engines.","type":"Landing Page","category":"Front-end Development","experience_type":"coursework","repo_url":"https://github.com/paulAlexSerban/prj--natours-tours-agency","demo_url":"https://paulalexserban.github.io/prj--natours-tours-agency/","status":"draft","pinned":false,"priority":1,"date":"November 1, 2020","tags":["Responsive Web Design","Scss/Sass","Webpack","JAMstack","GitHub Actions","Web Accessibility (a11y)","SEO","JavaScript","Handlebars","Deployment"],"slug":"prj--natours-natoure-tours-website"},{"title":"Trillo - All-in-One Booking App","subheading":"UI for fictional All-in-One Booking App","excerpt":"Trillo is a fictional All-in-One Booking App that allows users to book hotels, flights, cars, and tours in one platform. The project is currently in the frontend mockup stage, built using modern technologies and best practices in web development. The mockup is a single-page application that is fully responsive, accessible, and optimized for search engines.","type":"All-in-one Booking App","category":"Front-end De