{
  "name": "@prj--personal-portfolio/core",
  "version": "1.19.4",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint:scripts": "shellcheck ./**/*.bash",
    "install:ci": "npm ci --omit=dev --ignore-scripts",
    "install:root": "npm install",
    "prepare": "husky install",
    "build:prod:test:live": "node scripts/build.js --env=prod --target-hosting=test --dataset=live",
    "build:prod:test:test": "node scripts/build.js --env=prod --target-hosting=test --dataset=live",
    "build:prod:test:preview": "node scripts/build.js --env=prod --target-hosting=test --dataset=preview",
    "serve:portfolio-website": "npx serve@latest ./frontend/portfolio-website/out"
  },
  "author": "Paul Serban",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.354.0",
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@semantic-release/changelog": "^6.0.1",
    "@semantic-release/commit-analyzer": "^9.0.2",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^8.0.4",
    "@semantic-release/npm": "^9.0.1",
    "@semantic-release/release-notes-generator": "^10.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^16.3.1",
    "gh-pages": "^5.0.0",
    "gulp": "^4.0.2",
    "husky": "^8.0.3",
    "semantic-release": "^19.0.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && npx cz --hook || true"
    }
  }
}
